onboarding = false

[terminal]
default_shell = "fish"
shell_mode = "auto"
new_cwd = "follow"

[ui]
show_agent_labels_on_pane_borders = true
agent_panel_sort = "spaces"

[ui.sidebar.agents]
rows = [
  ["state_icon", "agent", "state_text"],
  ["workspace", "tab"],
]

[ui.sound]
enabled = false

[ui.toast]
delivery = "herdr"
delay_seconds = 1

[ui.toast.herdr]
position = "top-right"

[theme]
name = "catppuccin"
auto_switch = false

[keys]
prefix = "ctrl+b"
focus_agent = "prefix+alt+1..9"
next_agent = "prefix+alt+j"
previous_agent = "prefix+alt+k"
new_worktree = ""
open_worktree = "prefix+shift+o"
remove_worktree = "prefix+alt+x"
previous_workspace = "prefix+["
next_workspace = "prefix+]"

{{ if eq .chezmoi.hostname "GQT244F4XN" }}
[[keys.command]]
key = "prefix+shift+g"
type = "plugin_action"
command = "local.sibling-worktree.open"
description = "create sibling Git worktree"
{{ end }}

[[keys.command]]
key = "alt+a"
type = "plugin_action"
command = "annotate.capture"
description = "annotate text"

[[keys.command]]
key = "prefix+shift+a"
type = "plugin_action"
command = "annotate.copy-context"
description = "copy annotations as context"

[[keys.command]]
key = "prefix+m"
type = "plugin_action"
command = "annotate.manage"
description = "manage annotations"

[[keys.command]]
key = "prefix+shift+f"
type = "plugin_action"
command = "annotate.open"
description = "review documents in this folder"

[[keys.command]]
key = "cmd+shift+a"
type = "plugin_action"
command = "annotate.last"
description = "review the agent's last reply"

[[keys.command]]
key = "prefix+alt+o"
type = "shell"
command = 'zed "${HERDR_ACTIVE_PANE_CWD:-.}"'
description = "open current directory in Zed"
